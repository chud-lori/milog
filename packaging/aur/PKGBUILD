# Maintainer: Lori <imlori000@gmail.com>
pkgname=milog-bin
pkgver=0.6.0
pkgrel=1
pkgdesc='Single-host nginx + system + app-error monitor with alerts'
arch=('x86_64' 'aarch64')
url='https://github.com/chud-lori/milog'
license=('MIT')
depends=('bash' 'coreutils' 'curl' 'gawk' 'sqlite')
provides=('milog')
conflicts=('milog')
options=('!debug')
_rel="$url/releases/download/v$pkgver"
# The release tarball lacks completions and the man page.
source=("milog-$pkgver-src.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
source_x86_64=("$_rel/milog_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("$_rel/milog_${pkgver}_linux_arm64.tar.gz")
sha256sums=('75f6f9aaf198b033da12e6724d796df0a1388abd0b99f9a967b185c054824d22')
sha256sums_x86_64=('63839179a8ce6a5c42966cc8353251eacdd44fea27800e0e7db849dfe2afe560')
sha256sums_aarch64=('cba5c1a15cbad4790b686a2132e147c054ff5214ef87226c16dec9830878049d')

package() {
  install -Dm755 milog.sh "$pkgdir/usr/bin/milog"
  install -Dm755 -t "$pkgdir/usr/bin" milog-web milog-tui milog-probe
  install -Dm644 -t "$pkgdir/usr/share/doc/milog" README.md SERVER_HARDENING.md
  install -Dm644 -t "$pkgdir/usr/share/doc/milog/docs" docs/*.md
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  cd "$srcdir/milog-$pkgver"
  install -Dm644 completions/milog.bash "$pkgdir/usr/share/bash-completion/completions/milog"
  install -Dm644 completions/_milog "$pkgdir/usr/share/zsh/site-functions/_milog"
  install -Dm644 completions/milog.fish "$pkgdir/usr/share/fish/vendor_completions.d/milog.fish"
  install -Dm644 man/milog.1 "$pkgdir/usr/share/man/man1/milog.1"
}
